{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "api",
    "worker",
    "apiSecret",
    "workerSecret",
    "migrationSecret"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "keda": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "authenticationRef": {
              "type": "string"
            },
            "lagThreshold": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    },
    "apiSecret": {
      "type": "string",
      "minLength": 1
    },
    "workerSecret": {
      "type": "string",
      "minLength": 1
    },
    "migrationSecret": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "not": {
              "enum": [
                "DATABASE_URL",
                "VOTE_DATABASE_URLS",
                "ADMIN_TOKEN",
                "SIGNING_KEY",
                "KAFKA_USER",
                "KAFKA_PASSWORD",
                "KAFKA_BROKERS",
                "KAFKA_TOPIC",
                "KAFKA_GROUP",
                "KAFKA_TLS",
                "COOKIE_SECURE",
                "MODE",
                "ADDR",
                "METRICS_ADDR",
                "WEB_DIR",
                "SHUTDOWN_TIMEOUT"
              ]
            }
          }
        },
        "kafkaBrokers": {
          "type": "string",
          "minLength": 1
        },
        "kafkaTopic": {
          "type": "string",
          "minLength": 1
        },
        "kafkaGroup": {
          "type": "string",
          "minLength": 1
        },
        "kafkaTLS": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        },
        "cookieSecure": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "sticky": {
          "type": "object",
          "required": [
            "enabled",
            "provider",
            "cookieName"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "enum": [
                "haproxy",
                "nginx"
              ]
            },
            "cookieName": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespace": {
          "type": "string",
          "minLength": 1
        },
        "monitoringNamespace": {
          "type": "string",
          "minLength": 1
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "dependencyCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dnsCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "databasePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "kafkaPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "enabled",
        "activeDeadlineSeconds",
        "startupTimeoutSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "shutdownTimeoutSeconds",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
