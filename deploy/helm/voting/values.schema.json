{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "api",
    "worker",
    "apiSecret",
    "workerSecret",
    "migrationSecret"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "keda": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "apiSecret": {
      "type": "string",
      "minLength": 1
    },
    "workerSecret": {
      "type": "string",
      "minLength": 1
    },
    "migrationSecret": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "not": {
              "enum": [
                "DATABASE_URL",
                "VOTE_DATABASE_URLS",
                "ADMIN_TOKEN",
                "SIGNING_KEY",
                "KAFKA_USER",
                "KAFKA_PASSWORD",
                "KAFKA_BROKERS",
                "KAFKA_TOPIC",
                "KAFKA_GROUP",
                "KAFKA_TLS",
                "COOKIE_SECURE",
                "MODE",
                "ADDR",
                "METRICS_ADDR",
                "WEB_DIR"
              ]
            }
          }
        }
      }
    }
  }
}
